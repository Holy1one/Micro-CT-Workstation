{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Micro-CT Workstation",
  "version": "0.1.0",
  "identifier": "edu.lzu.microct.workstation",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 4173 --strictPort",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [{"title": "Micro-CT Workstation", "width": 1600, "height": 900, "minWidth": 1280, "minHeight": 720}],
    "security": {"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ct-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
