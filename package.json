{
  "name": "micro-ct-app",
  "version": "0.9.54",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/build/prepare-assets.mjs && vite --config frontend/vite.config.mjs",
    "build": "node tools/build/prepare-assets.mjs && vite build --config frontend/vite.config.mjs && node tools/build/prepare-sites-build.mjs",
    "typecheck": "tsc --noEmit --project frontend/tsconfig.json",
    "test": "npm run typecheck && npm run test:sites",
    "module-map:generate": "node tools/verify/gen-module-graph.mjs",
    "module-map:check": "node tools/verify/verify-module-map.mjs && node tools/verify/gen-module-graph.mjs --check",
    "impact": "node tools/verify/impact.mjs",
    "engine:build": "node tools/build/prepare-engine-sidecar.mjs",
    "tauri:dev": "npm run engine:build && node tools/build/run-tauri.mjs dev",
    "tauri:build": "node tools/release/build-update-release.mjs",
    "firmware:build": "node tools/build/build-turntable-firmware.mjs",
    "firmware:test": "node tests/firmware/test-turntable-firmware.mjs",
    "preview": "vite preview --config frontend/vite.config.mjs",
    "test:frontend": "node --experimental-strip-types --test tests/frontend/*.test.mjs",
    "test:desktop": "node --experimental-strip-types --test tests/desktop/*.test.mjs",
    "test:backend": "cargo test --manifest-path backend/Cargo.toml --workspace",
    "test:sites": "npm run build && npm run test:frontend && npm run test:desktop",
    "verify": "npm run module-map:check && npm test && npm run test:backend && npm run firmware:test",
    "installer:build": "node tools/release/build-update-release.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.4.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.180.0",
    "typescript": "^7.0.2"
  }
}
