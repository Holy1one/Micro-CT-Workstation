{
  "name": "micro-ct-app",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:sites",
    "module-map:generate": "node scripts/gen-module-graph.mjs",
    "module-map:check": "node scripts/verify-module-map.mjs && node scripts/gen-module-graph.mjs --check",
    "impact": "node scripts/impact.mjs",
    "engine:build": "node scripts/prepare-engine-sidecar.mjs",
    "tauri:dev": "npm run engine:build && tauri dev",
    "tauri:build": "npm run engine:build -- --release && tauri build",
    "portable:build": "node scripts/build-portable.mjs",
    "preview": "vite preview",
    "test:sites": "npm run build && node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.4.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.180.0",
    "typescript": "^7.0.2"
  }
}
