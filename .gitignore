# Dependency, compiler, and packaging output
node_modules/
dist/
target/
release/
portable-release/build-info.json
src-tauri/binaries/
.vite/
# Approved local artifact hierarchy. AGENTS.md defines the required
# tmp/{cache,tests,debug,sessions,screenshots}/<module>/<run-id> layout.
tmp/

# Logs and runtime crash output
*.log
*.stackdump
*.dmp
*.dump
*.trace
*.profraw
*.profdata

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor and IDE-local state
.vs/
.history/
*.swp
*.swo
*~
*.suo
*.user
*.userosscache
*.sln.docstates

# Language/tool caches
**/__pycache__/
*.py[cod]
*.tsbuildinfo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/

# Local environment and secrets
.env
.env.*
!.env.example
*.local

# Local QA / agent scratch output - never part of the shipped source.
.ai-memory/
.cleanup-backup/
.qa-*.txt
.verification-status.txt
build-check-evidence.tmp
qa-browser-snapshot.txt
qa-output/
docs/shots/.tmp/

# Generated window-level acceptance captures. Keep authored documentation
# screenshots and checked-in baselines; ignore only this repeatable QA series.
docs/shots/window-geometry-*-window-printwindow.png
